<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/includes/header.jsp"/><main class="content-container"><h1><c:out value="${atelier.titre}"/></h1><p><c:out value="${atelier.description}"/></p><p>Date : <c:out value="${atelier.dateHeureFormattee}"/></p><p>Capacité : <c:out value="${atelier.capacite}"/> · Inscriptions confirmées : <c:out value="${confirmes}"/> · Places disponibles : <c:out value="${atelier.capacite-confirmes}"/></p><c:choose><c:when test="${commence}"><strong>Atelier déjà commencé</strong></c:when><c:when test="${atelier.capacite le confirmes}"><strong>Atelier complet</strong></c:when><c:when test="${sessionScope.role eq 'ETUDIANT'}"><form method="post" action="${pageContext.request.contextPath}/inscription/action"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="atelierId" value="${atelier.id}"><button class="btn btn-primary">S’inscrire</button></form></c:when><c:otherwise><a class="btn btn-primary" href="${pageContext.request.contextPath}/connexion">Connectez-vous pour vous inscrire</a></c:otherwise></c:choose><p><a href="${pageContext.request.contextPath}/catalogue">Retour au catalogue</a></p></main><jsp:include page="/includes/footer.jsp"/>

