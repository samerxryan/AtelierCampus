<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/includes/header.jsp"/><main class="content-container"><h1>Gestion des ateliers</h1><c:if test="${param.ok eq 'sauvegarde'}"><p role="status">Les modifications ont été enregistrées.</p></c:if><a class="btn btn-primary" href="${pageContext.request.contextPath}/gestion/nouveau">Créer un atelier</a><c:forEach var="a" items="${ateliers}"><article class="recap-content-card"><h2><c:out value="${a.titre}"/></h2><p><c:out value="${a.dateHeureFormattee}"/> · Capacité <c:out value="${a.capacite}"/></p><a href="${pageContext.request.contextPath}/gestion/modifier?id=${a.id}">Modifier</a> · <a href="${pageContext.request.contextPath}/gestion/participants?id=${a.id}">Participants</a><form method="post" action="${pageContext.request.contextPath}/gestion/supprimer"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="id" value="${a.id}"><button>Supprimer</button></form></article></c:forEach></main><jsp:include page="/includes/footer.jsp"/>

