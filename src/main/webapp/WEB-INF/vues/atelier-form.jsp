<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %><jsp:include page="/includes/header.jsp"/><main class="content-container"><h1>Atelier</h1><form method="post" action="${pageContext.request.contextPath}/gestion/enregistrer"><input type="hidden" name="csrf" value="${csrf}"><c:if test="${not empty atelier}"><input type="hidden" name="id" value="${atelier.id}"></c:if><label>Titre <input name="titre" required maxlength="180" value="${fn:escapeXml(atelier.titre)}"></label><label>Description <textarea name="description" required><c:out value="${atelier.description}"/></textarea></label><label>Date et heure <input type="datetime-local" name="dateHeure" required value="${dateHeureInput}"></label><label>Capacité <input type="number" min="1" name="capacite" required value="${atelier.capacite}"></label><button class="btn btn-primary">Enregistrer</button></form></main><jsp:include page="/includes/footer.jsp"/>

