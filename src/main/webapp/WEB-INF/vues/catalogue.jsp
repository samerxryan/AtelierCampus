<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %><jsp:include page="/includes/header.jsp"/><main class="content-container"><h1>Catalogue des ateliers</h1><form method="get" action="${pageContext.request.contextPath}/catalogue"><label>Rechercher par titre <input name="q" value="${fn:escapeXml(param.q)}" maxlength="180"></label><button class="btn btn-primary">Rechercher</button></form><div class="catalogue-grid"><c:forEach var="a" items="${ateliers}"><article class="recap-content-card"><h2><c:out value="${a.titre}"/></h2><p><c:out value="${a.description}"/></p><p>Date : <c:out value="${a.dateHeureFormattee}"/> · Capacité : <c:out value="${a.capacite}"/> · Places confirmées : <c:out value="${confirmes[a.id]}"/></p><a class="btn btn-secondary" href="${pageContext.request.contextPath}/atelier?id=${a.id}">Détails</a></article></c:forEach></div></main><jsp:include page="/includes/footer.jsp"/>

