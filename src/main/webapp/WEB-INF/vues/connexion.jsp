<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/includes/header.jsp"/><main class="content-container"><h1>Connexion</h1><c:if test="${not empty message}"><p role="alert"><c:out value="${message}"/></p></c:if><form method="post" action="${pageContext.request.contextPath}/connexion"><input type="hidden" name="csrf" value="${csrf}"><label>Adresse électronique <input type="email" name="email" required maxlength="120" autocomplete="username"></label><label>Mot de passe <input type="password" name="mot_de_passe" required autocomplete="current-password"></label><button class="btn btn-primary">Se connecter</button></form></main><jsp:include page="/includes/footer.jsp"/>
