<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/includes/header.jsp"/><main class="content-container"><h1>Mes inscriptions</h1><c:if test="${param.ok eq 'inscription'}"><p role="status">Inscription confirmée avec succès.</p></c:if><c:if test="${param.ok eq 'annulation'}"><p role="status">Inscription annulée ; la place est disponible à nouveau.</p></c:if><c:forEach var="i" items="${inscriptions}"><article class="recap-content-card"><h2><c:out value="${i.titre}"/></h2><p>Statut : <c:out value="${i.statut}"/> · Date : <c:out value="${i.date_heure}"/> · Places disponibles : <c:out value="${i.capacite-i.inscrits}"/></p><c:if test="${i.statut eq 'CONFIRMEE'}"><form method="post" action="${pageContext.request.contextPath}/inscription/action"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="action" value="annuler"><input type="hidden" name="id" value="${i.id}"><button class="btn btn-secondary">Annuler l’inscription</button></form></c:if></article></c:forEach></main><jsp:include page="/includes/footer.jsp"/>

